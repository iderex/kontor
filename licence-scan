#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# Two refusals about the licence, and neither of them reads the licence text.
#
# Run from anywhere. With no rule it runs both:
#
#     licence-scan
#     licence-scan headers
#     licence-scan dependencies
#
# The workflow calls it with one rule per job, so each keeps its own name on a
# pull request, and a contributor calls it with none.
#
# A second argument names the repository to read, and defaults to this one. It
# exists so prove-licences can point the shipped scanner at a fixture repository
# rather than at a copy of these rules.
#
# WHERE THE IDENTIFIER COMES FROM. Nowhere in this file. It is read out of the
# two workspace manifests, which already declare it because the two package
# ecosystems require it, and a disagreement between them is refused before
# anything else runs. A third copy written here would be the one that drifts,
# and it would drift silently: a header check comparing against its own constant
# passes a tree whose manifests say something else.
#
# WHAT THE HEADER RULE COVERS. Tracked files in the two source languages, and
# tracked files that begin with a shebang, which is what the scripts at the root
# of this tree are. Not documents, not manifests, not configuration, and not the
# two generated lock files: a licence header belongs where a file could travel
# out of this tree and be read on its own as code, and regenerate is the register
# for the files nobody edits by hand.
#
# WHAT THE DEPENDENCY RULE CANNOT DO. It reads what a package declares about
# itself and compares it against licences-allowed. It does not read the licence
# text of anything, it does not know whether a declaration is true, and it is
# not a legal opinion. What it refuses is a dependency arriving under a licence
# nobody has written a reason for, which is the failure that otherwise surfaces
# at a release.
#
# POSIX sh, matching text-scan and test-scan, with node for the two JSON
# documents for the reason docs/layout.md gives: this tree already requires node
# and does not require jq. Both rules are questions about text and about JSON
# that a package manager already produced, so neither toolchain has to be built
# before this can refuse anything.
#
# prove-licences is what shows this file bites, and it runs this file rather
# than a copy of its rules.
set -eu

rule=${1-all}
case "$rule" in
    headers | dependencies | all) ;;
    *)
        echo "licence-scan: '$rule' is not a rule. Use headers, dependencies, or nothing for both." >&2
        exit 2
        ;;
esac

root=$(CDPATH= cd "${2:-$(dirname "$0")}" && pwd)
cd "$root"

command -v git >/dev/null 2>&1 || {
    echo "licence-scan: git is not on the path, and the register of what to judge comes from git." >&2
    exit 2
}

# The identifier both manifests declare, or a refusal naming the disagreement.
#
# Printed on stdout so a caller reads it through a command substitution; every
# message goes to stderr so it cannot be mistaken for the value.
identifier() {
    from_cargo=$(sed -n 's/^license = "\([^"]*\)".*/\1/p' server/Cargo.toml 2>/dev/null | head -n 1)
    from_npm=$(sed -n 's/^[[:space:]]*"license"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' client/package.json 2>/dev/null | head -n 1)

    if [ -z "$from_cargo" ] || [ -z "$from_npm" ]; then
        echo "licence-scan: server/Cargo.toml declares '$from_cargo' and client/package.json declares '$from_npm', and a header rule with nothing to compare against would pass every file. Failing closed." >&2
        return 1
    fi

    if [ "$from_cargo" != "$from_npm" ]; then
        echo "licence-scan: server/Cargo.toml declares '$from_cargo' and client/package.json declares '$from_npm'. One of the two layers is under a licence the other does not know about, and until they agree there is no identifier for a header to carry." >&2
        return 1
    fi

    printf '%s\n' "$from_cargo"
}

# Every tracked file a licence header is owed on.
#
# The shebang half is one pass over the index rather than one process per file:
# git grep prints file:line:match, and a shebang is only a shebang on line 1.
register() {
    {
        git ls-files -- '*.rs' '*.ts' '*.js' '*.mjs' '*.cjs'
        git grep --cached -I -n -E '^#!' -- . | awk -F: '$2 == 1 { print $1 }'
    } | sort -u
}

headers() {
    id=$(identifier) || return 1

    # The register becomes the argument list, because the judging below is one
    # awk pass over every file rather than a pair of processes per file. That is
    # not a micro-optimisation: a loop spawning head and sed forty times is
    # minutes rather than seconds on a machine where a fork is expensive, and a
    # check somebody will not wait for is a check somebody runs after pushing.
    set --
    while IFS= read -r file; do
        [ -n "$file" ] || continue
        if [ ! -f "$file" ]; then
            echo "licence-scan: $file is tracked and is not in the working tree, so there is nothing to read a header out of." >&2
            return 1
        fi
        set -- "$@" "$file"
    done <<EOF
$(register)
EOF

    if [ "$#" -eq 0 ]; then
        echo "licence-scan: no tracked file is in either source language and none begins with a shebang, so this rule would refuse nothing. Failing closed rather than passing an empty register." >&2
        return 1
    fi

    # The comment marker comes from the extension, and the line the header is
    # owed on is the first, unless the first is a shebang: the kernel only reads
    # one there, so nothing may be put above it.
    #
    # A trailing carriage return is stripped before the comparison. This tree's
    # .gitattributes gives every one of these files LF in the working tree as
    # well as in the index, so it should never be there; text-scan is the check
    # that judges line endings, and this one refusing a file for its ending
    # would report the wrong rule.
    if problems=$(awk -v id="$id" '
        function wanted_for(path,   marker) {
            marker = (path ~ /\.(rs|ts|js|mjs|cjs)$/) ? "//" : "#"
            return marker " SPDX-License-Identifier: " id
        }
        FNR == 1 { sub(/\r$/, ""); first[FILENAME] = $0 }
        FNR == 2 { sub(/\r$/, ""); second[FILENAME] = $0 }
        END {
            wrong = 0
            for (i = 1; i < ARGC; i++) {
                path = ARGV[i]
                at = (first[path] ~ /^#!/) ? 2 : 1
                got = (at == 2) ? second[path] : first[path]
                want = wanted_for(path)
                if (got != want) {
                    printf "  FAIL  %s line %d is \"%s\" and has to be \"%s\"\n", path, at, got, want
                    wrong++
                }
            }
            if (wrong > 0) exit 1
        }
    ' "$@"); then
        echo "licence-scan: $# tracked source files, every one carrying $id on its first line or under its shebang."
    else
        printf '%s\n' "$problems" >&2
        echo "licence-scan: some of the $# tracked source files carry no licence header, or carry one naming something else. A file travels: copied into another tree it is read on its own, and the root of this one does not go with it. Run ./licence-apply to write the missing ones." >&2
        return 1
    fi
}

dependencies() {
    id=$(identifier) || return 1

    command -v node >/dev/null 2>&1 || {
        echo "licence-scan: node is not on the path. CONTRIBUTING.md says what to install." >&2
        return 2
    }
    command -v cargo >/dev/null 2>&1 || {
        echo "licence-scan: cargo is not on the path. CONTRIBUTING.md says what to install." >&2
        return 2
    }

    # --locked so a licence scan cannot be the run that quietly resolves a
    # different dependency set from the one that ships, which is ./lint's reason
    # for the same flag.
    cargo metadata --format-version 1 --locked --manifest-path server/Cargo.toml \
        | node -e '
const fs = require("node:fs");

const identifier = process.argv[1];
const listPath = process.argv[2];
const lockPath = process.argv[3];

// The allow list, and the rule that every entry carries a reason.
//
// The reason is the comment line immediately above the entry. Requiring it here
// rather than asking for it in a document is what makes an exception a decision
// somebody wrote down: an entry appended with no line above it is refused, so
// the list cannot grow by accumulation.
function readAllowList(path) {
  if (!fs.existsSync(path)) {
    throw new Error(
      `${path} is not there, so every dependency licence would be judged against an empty list. Failing closed.`,
    );
  }

  const lines = fs.readFileSync(path, "utf8").split("\n");
  const licences = new Set();
  const packages = new Set();
  const unreasoned = [];

  lines.forEach((line, index) => {
    const entry = line.trim();
    if (entry === "" || entry.startsWith("#")) return;

    const above = (lines[index - 1] || "").trim();
    if (!above.startsWith("#") || above.replace(/^#+/, "").trim() === "") {
      unreasoned.push(`${path} line ${index + 1}: "${entry}" has no reason on the line above it`);
    }

    const named = entry.match(/^package[ \t]+(\S+)$/);
    if (named) packages.add(named[1]);
    else licences.add(entry);
  });

  if (unreasoned.length > 0) {
    const trailer =
      "an entry with no reason is a licence somebody accepted without saying why, which is the accumulation this list exists against.";
    throw new Error([...unreasoned, trailer].join("\n"));
  }

  if (licences.size === 0 && packages.size === 0) {
    throw new Error(`${path} holds no entry, so this rule would refuse every dependency. Failing closed.`);
  }

  return { licences, packages };
}

// An SPDX expression, judged against the set of licences that are allowed.
//
// OR is satisfied by either side, because the dependency may be taken under
// whichever one this project can use. AND needs both, because both apply at
// once. The slash form is not SPDX and predates it; crates in the wild still
// carry it and every one of them means OR. WITH binds tighter than either and
// is kept whole, so an exception is a decision about that exact pair rather
// than about the licence it modifies.
function tokenise(expression) {
  return expression
    .replace(/\//g, " OR ")
    .replace(/\(/g, " ( ")
    .replace(/\)/g, " ) ")
    .split(/\s+/)
    .filter((token) => token !== "");
}

function satisfied(expression, allowed) {
  const tokens = tokenise(expression);
  let at = 0;

  const leaf = () => {
    if (tokens[at] === "(") {
      at += 1;
      const inner = or();
      if (tokens[at] !== ")") throw new Error(`unbalanced brackets in "${expression}"`);
      at += 1;
      return inner;
    }
    let name = tokens[at];
    if (name === undefined) throw new Error(`"${expression}" ends where a licence was expected`);
    at += 1;
    if (tokens[at] === "WITH") {
      name = `${name} WITH ${tokens[at + 1]}`;
      at += 2;
    }
    return allowed.has(name);
  };

  const and = () => {
    let value = leaf();
    while (tokens[at] === "AND") {
      at += 1;
      value = leaf() && value;
    }
    return value;
  };

  const or = () => {
    let value = and();
    while (tokens[at] === "OR") {
      at += 1;
      value = and() || value;
    }
    return value;
  };

  const value = or();
  if (at !== tokens.length) throw new Error(`"${expression}" carries "${tokens[at]}" where nothing was expected`);
  return value;
}

// What is judged, from cargo. Workspace members are this project, and this
// project is judged too: a member declaring something other than the identifier
// the manifests agree on is the same defect as a dependency doing it.
function fromCargo(raw) {
  const meta = JSON.parse(raw);
  const members = new Set(meta.workspace_members);
  return meta.packages.map((pkg) => ({
    where: members.has(pkg.id) ? "server workspace" : "crates.io",
    name: `${pkg.name} ${pkg.version}`,
    declared: pkg.license,
  }));
}

// What is judged, from the npm lock file rather than from an installed tree.
// The lock is what npm ci installs and it is tracked, so the scan judges what
// will be there rather than what happens to be there now.
//
// A link entry is a workspace package reached through node_modules; its own
// entry is in the same file under its path and is judged there.
function fromLock(path) {
  if (!fs.existsSync(path)) {
    throw new Error(`${path} is not there, so nothing on the client side would be judged. Failing closed.`);
  }
  const lock = JSON.parse(fs.readFileSync(path, "utf8"));
  return Object.entries(lock.packages || {})
    .filter(([, entry]) => entry.link !== true)
    .map(([where, entry]) => ({
      where: where === "" ? "client workspace root" : where,
      name: entry.name || where || "the client workspace root",
      declared: entry.license,
    }));
}

let raw = "";
process.stdin.on("data", (chunk) => (raw += chunk)).on("end", () => {
  let allow;
  let judged;
  try {
    allow = readAllowList(listPath);
    judged = [...fromCargo(raw), ...fromLock(lockPath)];
  } catch (problem) {
    process.stderr.write(`licence-scan: ${problem.message}\n`);
    process.exit(1);
  }

  const problems = [];
  for (const pkg of judged) {
    if (allow.packages.has(pkg.name.split(" ")[0])) continue;

    if (!pkg.declared) {
      problems.push(
        `${pkg.name} (${pkg.where}) declares no licence at all. Either it goes, or licences-allowed carries "package ${pkg.name.split(" ")[0]}" with the reason above it.`,
      );
      continue;
    }

    let ok;
    try {
      ok = satisfied(pkg.declared, allow.licences);
    } catch (problem) {
      problems.push(`${pkg.name} (${pkg.where}) declares "${pkg.declared}", which does not read as an expression: ${problem.message}`);
      continue;
    }

    if (!ok) {
      problems.push(
        `${pkg.name} (${pkg.where}) is under "${pkg.declared}", and licences-allowed does not carry every part of that. This project is ${identifier}, and what it may be combined with is a decision with a reason rather than a default.`,
      );
    }
  }

  if (problems.length > 0) {
    for (const line of problems) process.stderr.write(`  FAIL  ${line}\n`);
    process.stderr.write(
      `licence-scan: ${problems.length} of ${judged.length} packages are not covered by licences-allowed. A licence noticed at a release is one that has already shipped.\n`,
    );
    process.exit(1);
  }

  process.stdout.write(
    `licence-scan: ${judged.length} packages across both toolchains, every declared licence covered by licences-allowed. What a package declares is what this reads; whether the declaration is true is not checkable here.\n`,
  );
});
' "$id" licences-allowed client/package-lock.json
}

case "$rule" in
    headers) headers ;;
    dependencies) dependencies ;;
    all)
        headers
        dependencies
        ;;
esac
