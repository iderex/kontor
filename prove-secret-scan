#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# The credential shape refusals, shown to bite.
#
#     prove-secret-scan
#
# Each leg builds a throwaway repository holding the file the case is about,
# runs the shipped scanner against it and reads the exit code. No leg restates a
# rule, so a shape loosened where it lives reddens the leg that depended on it
# rather than passing quietly.
#
# Every red leg is followed by its one-change neighbour, which has to pass.
# Without that pair a leg is also satisfied by a scanner that refuses whatever
# it is given, and the near miss is small on purpose: the same value with the
# credentials taken out of it, the same assignment reading the environment
# instead, the same token one character short of the length the shape names.
#
# The fixtures are repositories rather than loose files because the rule is
# about what is TRACKED. A value sitting in a working tree and never committed
# is not in the repository, and one leg below is that distinction on its own.
#
# ONE LEG READS WHAT THE REFUSAL DID NOT SAY. The scanner is the one place a
# credential in this tree is guaranteed to be handled, and a check that quoted
# what it found would put the value into the log of every run that refused it.
# That leg asserts the value is absent from everything the run printed, which is
# the only way round that a green exit code cannot give.
#
# THE VALUES BELOW ARE FIXTURE VALUES. None of them unlocks anything: the key
# block is a header with no key under it, the host in the connection string is
# under the domain reserved for examples, and the token was made up character by
# character to have the shape one service issues. Each of them is also declared
# in secrets-allowed, because this file is tracked text like any other and the
# scanner reads it. That is the register being exercised by the tree it judges
# rather than only by its own legs.
#
# This tree is not what any leg judges. A run against the real files proves the
# state of those files on the day it ran, and the rule is what this file is
# about.
#
# The legs run the scanner through sh rather than as a path. prove-headless is
# where the difference between the two is a rule with its own pair of legs, and
# it holds that question for every script here rather than each one asking it
# again.
#
# POSIX sh, matching the script it proves, and for the same reason: a leg is an
# exit code from another program and nothing here needs a language that can do
# more than run one and read what it printed.
set -eu

cd "$(CDPATH= cd "$(dirname "$0")" && pwd)"

root=$(pwd)
failed=0
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
count=0

pass() { echo "  ok    $1"; }
fail() { echo "  FAIL  $1" >&2; failed=1; }

# A repository the case writes its files into. Line ending rewriting is turned
# off because this machine may be set to it, and the warning git prints on every
# fixture would bury the legs.
fixture() {
    count=$((count + 1))
    tmp="$work/$count"
    stage=-A
    git -c init.defaultBranch=main init -q "$tmp"
    git -C "$tmp" config core.autocrlf false
}

# Content arrives on standard input, so a fixture file is written the way it
# will be read rather than through a layer of quoting.
put() {
    mkdir -p "$tmp/$(dirname "$1")"
    cat > "$tmp/$1"
}

# The register with nothing declared in it, which is what a fixture wants where
# the case is about a value being refused. A leg that wants an entry writes its
# own instead of calling this.
register() {
    put secrets-allowed <<'ALLOWED'
# The fixture's register, declaring nothing.
ALLOWED
}

judge() {
    what=$1
    expectation=$2
    needle=$3

    # Every leg but one tracks what it wrote. The exception sets stage to the
    # subset it wants tracked, because the rule is about what is committed and a
    # fixture that tracked everything could not put that distinction under it.
    git -C "$tmp" add $stage

    if out=$(sh "$root/secret-scan" "$tmp" 2>&1); then
        if [ "$expectation" = green ]; then
            pass "$what"
        else
            fail "$what (it passed, and it was supposed to be refused)"
        fi
    else
        if [ "$expectation" = red ]; then
            case $out in
                *"$needle"*) pass "$what" ;;
                *) fail "$what (it was refused, and not for this leg's reason: nothing it printed held '$needle')" ;;
            esac
        else
            fail "$what (it was refused, and it was supposed to pass)"
        fi
    fi
}

echo "prove-secret-scan: a shape the tree may not carry"

fixture
register
put deploy/key <<'FILE'
-----BEGIN OPENSSH PRIVATE KEY-----
FILE
judge "a private key block in a tracked file is refused" \
    red "a private key block"

fixture
register
put deploy/key <<'FILE'
The key this deployment uses is read from the environment.
FILE
judge "the same file with the block taken out is accepted" \
    green ""

fixture
register
put docs/running.md <<'FILE'
Point it at amqp://carrier:hunter2@queue.example and it will connect.
FILE
judge "a value carrying credentials inside a URL is refused" \
    red "credentials inside a URL"

fixture
register
put docs/running.md <<'FILE'
Point it at amqp://queue.example and it will connect.
FILE
judge "the same value with the credentials taken out is accepted" \
    green ""

fixture
register
put src/client.ts <<'FILE'
const api_key = "Zq4Xr8Tm2Lp6Vd9Kc1Bn";
FILE
judge "a quoted literal assigned to a name meaning a credential is refused" \
    red "a secret in an assignment"

fixture
register
put src/client.ts <<'FILE'
const api_key = process.env.KONTOR_API_KEY;
FILE
judge "the same assignment reading the environment is accepted" \
    green ""

fixture
register
put deploy/notes.txt <<'FILE'
The account this ran under was AKIAQZ7RTUVWXY234567 before it was revoked.
FILE
judge "a token shaped the way a service issues one is refused" \
    red "a token a service issued"

fixture
register
put deploy/notes.txt <<'FILE'
The account this ran under was AKIAQZ7RTUVWXY23456 before it was revoked.
FILE
judge "the same token one character short of the shape is accepted" \
    green ""

echo "prove-secret-scan: what the refusal is allowed to say"

fixture
register
put docs/running.md <<'FILE'
Point it at amqp://carrier:hunter2@queue.example and it will connect.
FILE
git -C "$tmp" add -A
if out=$(sh "$root/secret-scan" "$tmp" 2>&1); then
    fail "the refusal repeats no value back (it passed, and it was supposed to be refused)"
else
    case $out in
        *carrier:hunter2*)
            fail "the refusal repeats no value back (the value was in what it printed)"
            ;;
        *docs/running.md:1*)
            pass "the refusal names the file and the line and repeats no value back"
            ;;
        *)
            fail "the refusal repeats no value back (it was refused, and it did not name where)"
            ;;
    esac
fi

echo "prove-secret-scan: the register"

fixture
put secrets-allowed <<'ALLOWED'
# The fixture's reason for the one value it declares.
amqp://carrier:hunter2@queue.example
ALLOWED
put docs/running.md <<'FILE'
Point it at amqp://carrier:hunter2@queue.example and it will connect.
FILE
judge "a value declared with a reason above it is accepted" \
    green ""

fixture
put secrets-allowed <<'ALLOWED'
amqp://carrier:hunter2@queue.example
ALLOWED
put docs/running.md <<'FILE'
Point it at amqp://carrier:hunter2@queue.example and it will connect.
FILE
judge "the same value declared with no reason above it is refused" \
    red "carries no reason on the line above it"

fixture
put secrets-allowed <<'ALLOWED'
# The fixture's reason, separated from its entry by a blank line.

amqp://carrier:hunter2@queue.example
ALLOWED
put docs/running.md <<'FILE'
Point it at amqp://carrier:hunter2@queue.example and it will connect.
FILE
judge "a reason separated from its entry by a blank line is refused as an absent one" \
    red "carries no reason on the line above it"

fixture
put secrets-allowed <<'ALLOWED'
# The fixture's reason for a value nothing in this repository holds.
amqp://carrier:hunter2@queue.example
ALLOWED
put docs/running.md <<'FILE'
Point it at amqp://queue.example and it will connect.
FILE
judge "an entry no tracked file answers is refused" \
    red "declares a value no tracked file carries"

fixture
put secrets-allowed <<'ALLOWED'
# The fixture's first reason.
amqp://carrier:hunter2@queue.example
# The fixture's second reason for the same value.
amqp://carrier:hunter2@queue.example
ALLOWED
put docs/running.md <<'FILE'
Point it at amqp://carrier:hunter2@queue.example and it will connect.
FILE
judge "the same value declared twice is refused" \
    red "the register already declares"

fixture
put docs/running.md <<'FILE'
Point it at amqp://queue.example and it will connect.
FILE
judge "a tree with no register is refused rather than being read as one with nothing to declare" \
    red "Failing closed rather than reading a missing register"

echo "prove-secret-scan: what it does not reach"

fixture
register
put docs/running.md <<'FILE'
Point it at amqp://carrier:hunter2@queue.example and it will connect.
FILE
stage=secrets-allowed
judge "a value in a file that is present and untracked is not judged" \
    green ""

fixture
register
put docs/running.md <<'FILE'
Point it at amqp://queue.example and it will connect.
FILE
judge "a tree carrying no shape this check knows judges nothing and passes" \
    green ""

if [ "$failed" -ne 0 ]; then
    echo "prove-secret-scan: a leg did not do what it says." >&2
    exit 1
fi

echo "prove-secret-scan: every leg did what it says."
