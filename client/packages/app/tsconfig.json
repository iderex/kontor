{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom"],
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "declaration": true,
    "composite": true,
    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": ["src"]
}
