{
  "name": "kontor-client",
  "private": true,
  "description": "The TypeScript web client workspace. What it holds is printed by: npm query .workspace --prefix client",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings",
    "test": "node --test \"packages/*/tests/**/*.test.ts\"",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "oxlint": "1.77.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
