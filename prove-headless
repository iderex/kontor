#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# The marking, shown to bite.
#
# A gate that has never refused anything is a claim, not a control. Every leg
# here runs the shipped scan against a fixture workspace and reads the exit code;
# none of them re-implements the register of reaches, so a shape removed from
# test-scan is removed here too and the leg that depended on it goes red.
#
# Run from anywhere:
#
#     ./prove-headless
#
# The fixtures are built rather than tracked. A tracked crate holding an unmarked
# test that opens a socket is exactly what test-scan refuses, so committing one
# would redden the real run for the sake of proving that it can. Each case is a
# throwaway cargo workspace with one crate, because the scan reads what cargo
# reports and nothing else.
#
# Two groups of legs, because test-scan carries two rules over one register. The
# first group is a test target and its marking. The second is a test inside a
# crate src/, which can carry no marking at all, and its legs are the ones that
# say the refusal is about the test rather than about the file it sits in.
#
# Every leg runs the shipped scan the way ./test and the workflow run it, as a
# path rather than as an argument to sh. That is not a style choice. This tree
# has twice lost a set of jobs to a script committed 100644 in a clone that does
# not carry the mode, on 2bbb79f and again while the connector guide rules were
# landing, and a proof passing the file to sh is green on exactly that tree
# because sh does not read the mode. Every leg here was written the losing way
# until this commit; nothing was broken by it, because test-scan is marked, and
# the leg that would have said so was the one that could not.
#
# POSIX sh, matching ./build, because the legs are exit codes from another
# program.
set -eu

cd "$(CDPATH= cd "$(dirname "$0")" && pwd)"

root=$(pwd)

command -v cargo >/dev/null 2>&1 || {
    echo "prove-headless: cargo is not on the path. CONTRIBUTING.md says what to install." >&2
    exit 1
}

failed=0

pass() {
    echo "  ok    $1"
}

fail() {
    echo "  FAIL  $1" >&2
    failed=1
}

expect_green() {
    what=$1
    shift
    if "$@" >/dev/null 2>&1; then
        pass "$what"
    else
        fail "$what (exit $?, and it was supposed to pass)"
    fi
}

expect_red() {
    what=$1
    shift
    if "$@" >/dev/null 2>&1; then
        fail "$what (it passed, and it was supposed to be refused)"
    else
        pass "$what"
    fi
}

echo "prove-headless: the marking"

# One throwaway workspace per case: a crate, a test target, and whatever
# required-features the case is about. The manifest is written here rather than
# copied from the tree, because what the case is about is the marking and not
# the lint or edition settings the real workspace carries.
marking_case() {
    what=$1
    body=$2
    marks=$3
    expectation=$4

    tmp=$(mktemp -d)
    mkdir -p "$tmp/crates/probe/src" "$tmp/crates/probe/tests"
    cat > "$tmp/Cargo.toml" <<EOF
[workspace]
resolver = "3"
members = ["crates/probe"]
EOF
    {
        echo '[package]'
        echo 'name = "probe"'
        echo 'version = "0.0.0"'
        echo 'edition = "2024"'
        echo 'publish = false'
        echo
        echo '[features]'
        echo 'needs-a-display = []'
        echo 'needs-an-outbound-network = []'
        echo 'needs-a-simulator = []'
        echo 'needs-postgres = []'
        echo 'invented-here = []'
        echo
        echo '[[test]]'
        echo 'name = "probe"'
        if [ -n "$marks" ]; then
            echo "required-features = [\"$marks\"]"
        fi
    } > "$tmp/crates/probe/Cargo.toml"
    echo '' > "$tmp/crates/probe/src/lib.rs"
    printf '%s\n' "$body" > "$tmp/crates/probe/tests/probe.rs"

    if [ "$expectation" = red ]; then
        expect_red "$what" "$root/test-scan" --root "$tmp"
    else
        expect_green "$what" "$root/test-scan" --root "$tmp"
    fi

    rm -rf "$tmp"
}

reaches_the_network='use std::net::TcpStream;
#[test]
fn it_connects() {
    let _ = TcpStream::connect("example.org:80");
}'

reaches_nothing='#[test]
fn it_adds() {
    assert_eq!(2 + 2, 4);
}'

reaches_a_display='#[test]
fn it_draws() {
    let _ = std::env::var("DISPLAY");
}'

marking_case "an unmarked test that opens an outbound socket is refused" \
    "$reaches_the_network" "" red

# The leg that says the refusal above is about the marking rather than about the
# bytes: the same file, with the target marked for what it needs, is accepted.
marking_case "the same test marked for an outbound network is accepted" \
    "$reaches_the_network" "needs-an-outbound-network" green

marking_case "an unmarked test that reaches for a display is refused" \
    "$reaches_a_display" "" red

marking_case "the same test marked for a display is accepted" \
    "$reaches_a_display" "needs-a-display" green

# The near miss. Somebody who has read the rule and marked the target, with a
# name of their own invention, has satisfied the shape of it and said nothing a
# reader or a workflow can act on.
marking_case "a marking naming something outside the four is refused" \
    "$reaches_the_network" "invented-here" red

# The leg that stops the evidence from being satisfied by a scan that refuses
# everything put in front of it.
marking_case "an unmarked test that reaches for nothing is accepted" \
    "$reaches_nothing" "" green

echo "prove-headless: a test inside a crate src/"

# The same shape without a test target. What these cases are about is a test that
# cannot be marked, so a manifest offering it a feature to be marked with would
# be offering the repair the message deliberately does not.
src_case() {
    what=$1
    lib=$2
    extra_name=$3
    extra=$4
    expectation=$5

    tmp=$(mktemp -d)
    mkdir -p "$tmp/crates/probe/src"
    cat > "$tmp/Cargo.toml" <<EOF
[workspace]
resolver = "3"
members = ["crates/probe"]
EOF
    {
        echo '[package]'
        echo 'name = "probe"'
        echo 'version = "0.0.0"'
        echo 'edition = "2024"'
        echo 'publish = false'
    } > "$tmp/crates/probe/Cargo.toml"
    printf '%s\n' "$lib" > "$tmp/crates/probe/src/lib.rs"
    if [ -n "$extra_name" ]; then
        printf '%s\n' "$extra" > "$tmp/crates/probe/src/$extra_name"
    fi

    if [ "$expectation" = red ]; then
        expect_red "$what" "$root/test-scan" --root "$tmp"
    else
        expect_green "$what" "$root/test-scan" --root "$tmp"
    fi

    rm -rf "$tmp"
}

in_crate_reaches_the_network='#[cfg(test)]
mod tests {
    use std::net::TcpStream;

    #[test]
    fn it_connects() {
        let _ = TcpStream::connect("example.org:80");
    }
}'

in_crate_reaches_nothing='#[cfg(test)]
mod tests {
    #[test]
    fn it_adds() {
        assert_eq!(2 + 2, 4);
    }
}'

# The near miss, and the one leg here worth the most. The reach is in the crate
# rather than in the test, one line above a test module that reaches for
# nothing. A scan that took the file instead of the item would refuse this, and
# it would be refusing library code under a message about tests.
library_reaches_the_network='use std::net::TcpStream;

pub fn dial() {
    let _ = TcpStream::connect("example.org:80");
}

#[cfg(test)]
mod tests {
    #[test]
    fn it_adds() {
        assert_eq!(2 + 2, 4);
    }
}'

# The same test, declared rather than written inline, which is the shape that
# escapes a reader looking at one file.
declares_a_test_module='#[cfg(test)]
mod tests;'

test_module_file='use std::net::TcpStream;

#[test]
fn it_connects() {
    let _ = TcpStream::connect("example.org:80");
}'

src_case "a test inside src/ that opens an outbound socket is refused" \
    "$in_crate_reaches_the_network" "" "" red

src_case "the same test with the reach taken out is accepted" \
    "$in_crate_reaches_nothing" "" "" green

src_case "the same reach in library code beside a clean test module is accepted" \
    "$library_reaches_the_network" "" "" green

src_case "a test module declared as a file, reaching the network, is refused" \
    "$declares_a_test_module" "tests.rs" "$test_module_file" red

echo "prove-headless: the harness runs the scan the way the workflow does"

# The pair that says why every leg above is a path rather than an argument to sh.
# Both halves run the same bytes and only the invocation differs, so the first
# going red and the second staying green is the whole statement.
#
# It needs a filesystem that can take the executable bit off a file. Windows
# cannot, and a pair asserted there would pass for a reason that has nothing to
# do with the mode, so the probe below decides and the skip is printed rather
# than swallowed.
probe=$(mktemp -d)
printf '#!/bin/sh\nexit 0\n' > "$probe/probe"
chmod -x "$probe/probe"

if [ -x "$probe/probe" ]; then
    echo "  skip  a scan the tree did not mark executable is refused"
    echo "  skip  the same file passed to sh is accepted"
    echo "prove-headless: this filesystem cannot take the executable bit off a file, so the pair above was not run and nothing here says the mode is covered."
else
    cp "$root/test-scan" "$probe/test-scan"
    chmod -x "$probe/test-scan"

    expect_red "a scan the tree did not mark executable is refused" \
        "$probe/test-scan"

    expect_green "the same file passed to sh is accepted, which is why no leg here does that" \
        sh "$probe/test-scan"
fi

rm -rf "$probe"

echo "prove-headless: the tree itself"

expect_green "every test target in this repository passes the same scan" \
    "$root/test-scan"

if [ "$failed" -ne 0 ]; then
    echo "prove-headless: a leg above did not do what it says. The marking is not proven." >&2
    exit 1
fi

echo "prove-headless: every leg did what it says."
