#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# A test that needs something the default suite cannot give it is marked, and an
# unmarked one that reaches for it is refused here rather than at an assertion.
#
# Run from anywhere:
#
#     test-scan
#     test-scan --root <directory>
#
# The four things a test in this project can need are a display server, an
# outbound network, a simulator and a database. They are the four
# docs/layout.md names, and each has a feature named for it. A test target that
# needs one declares that feature in `required-features`, which is what keeps it
# out of ./test, and the feature name is what says WHICH of the four it needs
# rather than only that it is special.
#
# WHY THIS RUNS BEFORE THE SUITE RATHER THAN INSIDE IT. An unmarked test that
# opens an outbound socket fails somewhere in the middle of a run, with a message
# about a connection, and reads exactly like a flake: rerun it on a machine with
# a network and it passes. The cause and the failure are far apart. Refusing the
# source before anything is compiled puts them together, and the message below
# names the file, the reach and the feature that would have made it legal.
#
# THE SECOND HALF, AND WHY ITS RULE IS A DIFFERENT ONE. A unit test inside a
# crate's src/, in a `#[cfg(test)]` module, is part of the library target. It
# cannot carry `required-features` at all, so there is no marking that would make
# a reach legal there and the message for one does not offer a feature name. The
# rule for those is that they may not reach for any of the four, and the repair
# is to move the test to a target under tests/ where it can be marked, or to take
# the reach out. Until this file judged them, a reader was the whole mechanism
# and #117 held the gap.
#
# WHAT THE SECOND HALF READS. Every .rs file under each workspace crate's src/,
# projected so that a brace inside a string or a comment does not move the depth,
# then every item carrying `#[cfg(test)]`. Where that item is `mod name;` rather
# than an inline module the file it names is read whole, and so is anything that
# file declares in turn, because all of it compiles only under the same cfg.
#
# WHAT IT DOES NOT REACH, STILL. Ordinary library code under src/ is not judged
# here, in either half. A crate that opens a socket outside a test is not this
# file's subject and no message here mentions it: that is the outbound boundary
# of docs/decisions/0011-connectors.md, and the pattern over the tree that would
# refuse one belongs to #113. A `#[cfg(test)]` module written inside a target
# under tests/ is also left alone, because that target already carries the
# marking this file checks in the first half.
#
# The authority for what is marked is cargo, read through `cargo metadata`, not a
# path convention: a convention is a second statement of the truth that drifts
# against the manifests. node reads the JSON because this tree already requires
# node and does not require jq, which is the reason docs/layout.md gives for the
# commands it prints elsewhere. The same metadata is what says where a crate's
# src/ is, for the same reason.
#
# POSIX sh, matching ./build, with the JSON reading handed to the one runtime the
# tree already pins.
#
# ./prove-headless is what shows this file bites, and it runs this file rather
# than a copy of its rules.
set -eu

root=.
if [ "${1-}" = "--root" ]; then
    root=$2
    shift 2
fi

cd "$(CDPATH= cd "$root" && pwd)"

command -v cargo >/dev/null 2>&1 || {
    echo "test-scan: cargo is not on the path. CONTRIBUTING.md says what to install." >&2
    exit 1
}
command -v node >/dev/null 2>&1 || {
    echo "test-scan: node is not on the path. CONTRIBUTING.md says what to install." >&2
    exit 1
}

manifest=server/Cargo.toml
[ -f "$manifest" ] || manifest=Cargo.toml

cargo metadata --format-version 1 --no-deps --manifest-path "$manifest" \
    | node -e '
// The register: the four things a test can need, the feature that marks each
// one, and the shapes in source that reach for it. The shapes are a floor and
// not a guarantee - they hold what a test in this tree could plausibly write
// today, and a reach nobody has written yet is not in the list.
//
// Both halves below read this one register. A shape taken out of it stops being
// refused in a test target and in a #[cfg(test)] module at the same moment,
// which is what stops the two halves drifting into two rules.
const needs = [
  {
    what: "a display server",
    feature: "needs-a-display",
    reaches: [/\bDISPLAY\b/, /\bwinit\b/, /\bwebdriver\b/i, /\bchromedriver\b/, /\bplaywright\b/i, /\bheadless_chrome\b/],
  },
  {
    what: "an outbound network",
    feature: "needs-an-outbound-network",
    reaches: [/\bTcpStream\b/, /\bUdpSocket\b/, /\bToSocketAddrs\b/, /\bstd::net\b/, /\breqwest\b/, /\bureq\b/],
  },
  {
    what: "a simulator",
    feature: "needs-a-simulator",
    reaches: [/\bsimctl\b/, /\bxcrun\b/, /\bemulator\b/, /\badb\s/],
  },
  {
    what: "a database",
    feature: "needs-postgres",
    reaches: [/postgres:\/\//, /\btokio_postgres\b/, /\bsqlx\b/, /KONTOR_TEST_DATABASE_URL/],
  },
];

const known = new Set(needs.map((n) => n.feature));
const fs = require("node:fs");
const path = require("node:path");

// Rust with every string, character literal and comment blanked out, indices and
// newlines preserved. Everything below matches against this rather than against
// the source, so a brace in a doc comment and a semicolon in a string literal
// move nothing. The source itself is what a reach is looked for in, because a
// socket address written as a string is exactly the case worth catching.
function codeOnly(src) {
  const out = src.split("");
  const n = src.length;
  const blank = (from, to) => {
    for (let k = from; k < to && k < n; k += 1) if (out[k] !== "\n") out[k] = " ";
  };
  let i = 0;
  while (i < n) {
    const c = src[i];
    if (c === "/" && src[i + 1] === "/") {
      let j = src.indexOf("\n", i);
      if (j < 0) j = n;
      blank(i, j);
      i = j;
      continue;
    }
    if (c === "/" && src[i + 1] === "*") {
      let depth = 1;
      let j = i + 2;
      while (j < n && depth > 0) {
        if (src[j] === "/" && src[j + 1] === "*") { depth += 1; j += 2; }
        else if (src[j] === "*" && src[j + 1] === "/") { depth -= 1; j += 2; }
        else j += 1;
      }
      blank(i, j);
      i = j;
      continue;
    }
    if (c === "r" || c === "b") {
      const before = i > 0 ? src[i - 1] : "";
      const raw = /^b?r(#*)"/.exec(src.slice(i, i + 64));
      if (raw && !/[A-Za-z0-9_]/.test(before)) {
        const close = String.fromCharCode(34) + raw[1];
        let j = src.indexOf(close, i + raw[0].length);
        j = j < 0 ? n : j + close.length;
        blank(i, j);
        i = j;
        continue;
      }
    }
    if (c === String.fromCharCode(34)) {
      let j = i + 1;
      while (j < n) {
        if (src[j] === "\\") j += 2;
        else if (src[j] === String.fromCharCode(34)) { j += 1; break; }
        else j += 1;
      }
      blank(i, j);
      i = j;
      continue;
    }
    if (c === "\x27") {
      // A character literal is blanked. A lifetime looks the same at this one
      // byte and carries nothing to blank, so it is stepped over instead.
      const ch = /^\x27(?:\\.|[^\\\x27])\x27/.exec(src.slice(i, i + 16));
      if (ch) {
        blank(i, i + ch[0].length);
        i += ch[0].length;
        continue;
      }
      i += 1;
      continue;
    }
    i += 1;
  }
  return out.join("");
}

// Past any further attributes stacked under the first one, to the head of the
// item they all apply to.
function skipAttributes(code, from) {
  let i = from;
  while (i < code.length) {
    while (i < code.length && /\s/.test(code[i])) i += 1;
    if (code[i] !== "#") return i;
    let j = code.indexOf("[", i);
    if (j < 0) return i;
    let depth = 0;
    while (j < code.length) {
      if (code[j] === "[") depth += 1;
      else if (code[j] === "]") {
        depth -= 1;
        if (depth === 0) { j += 1; break; }
      }
      j += 1;
    }
    i = j;
  }
  return i;
}

// The end of one item: the brace that closes it, or the semicolon that ends a
// declaration. Brackets and parentheses are counted so that a semicolon inside
// an array length or a closure argument does not end the item early.
function itemEnd(code, from) {
  let curly = 0;
  let other = 0;
  let opened = false;
  for (let i = from; i < code.length; i += 1) {
    const c = code[i];
    if (c === "{") { curly += 1; opened = true; }
    else if (c === "}") {
      curly -= 1;
      if (curly <= 0 && opened) return i + 1;
    } else if (c === "(" || c === "[") other += 1;
    else if (c === ")" || c === "]") other -= 1;
    else if (c === ";" && curly === 0 && other === 0) return i + 1;
  }
  return code.length;
}

const MOD_DECL = /^\s*(?:pub\s*(?:\([^)]*\)\s*)?)?mod\s+([A-Za-z_][A-Za-z0-9_]*)\s*;/;
const ANY_MOD_DECL = /(?:^|\n)\s*(?:pub\s*(?:\([^)]*\)\s*)?)?mod\s+([A-Za-z_][A-Za-z0-9_]*)\s*;/g;

// Where `mod name;` resolves to, by the two names rustc looks for.
function moduleFile(from, name) {
  const base = path.basename(from);
  const dir = base === "lib.rs" || base === "main.rs" || base === "mod.rs"
    ? path.dirname(from)
    : path.join(path.dirname(from), base.replace(/\.rs$/, ""));
  for (const candidate of [path.join(dir, name + ".rs"), path.join(dir, name, "mod.rs")]) {
    if (fs.existsSync(candidate)) return candidate;
  }
  return null;
}

function rsFiles(dir) {
  let entries = [];
  try {
    entries = fs.readdirSync(dir, { withFileTypes: true });
  } catch {
    return [];
  }
  const found = [];
  for (const entry of entries) {
    const full = path.join(dir, entry.name);
    if (entry.isDirectory()) found.push(...rsFiles(full));
    else if (entry.name.endsWith(".rs")) found.push(full);
  }
  return found;
}

const regions = [];
const whole = new Set();

function lineOf(src, index) {
  return src.slice(0, index).split("\n").length;
}

// A file that compiles only under cfg(test) is test source from its first byte,
// and so is every module it declares, whether or not that declaration repeats
// the attribute.
function takeWholeFile(file) {
  const key = path.resolve(file);
  if (whole.has(key)) return;
  whole.add(key);
  const src = fs.readFileSync(file, "utf8");
  regions.push({ file, line: 1, text: src });
  const code = codeOnly(src);
  ANY_MOD_DECL.lastIndex = 0;
  let found;
  while ((found = ANY_MOD_DECL.exec(code)) !== null) {
    const target = moduleFile(file, found[1]);
    if (target) takeWholeFile(target);
  }
}

function takeCfgTestItems(file) {
  const src = fs.readFileSync(file, "utf8");
  const code = codeOnly(src);
  const attribute = /#\s*\[\s*cfg\s*\(\s*test\s*\)\s*\]/g;
  let found;
  while ((found = attribute.exec(code)) !== null) {
    const head = skipAttributes(code, found.index + found[0].length);
    const declaration = MOD_DECL.exec(code.slice(head, head + 200));
    if (declaration) {
      const target = moduleFile(file, declaration[1]);
      if (target) {
        takeWholeFile(target);
        continue;
      }
    }
    regions.push({
      file,
      line: lineOf(src, found.index),
      text: src.slice(head, itemEnd(code, head)),
    });
  }
}

let raw = "";
process.stdin.on("data", (d) => (raw += d)).on("end", () => {
  const meta = JSON.parse(raw);
  const problems = [];
  let looked = 0;

  for (const pkg of meta.packages) {
    for (const target of pkg.targets) {
      if (!target.kind.includes("test")) continue;
      looked += 1;
      const marks = target["required-features"] || [];

      // A marking that names something outside the register is a marking
      // nothing here can read, which is the same as no marking at all.
      for (const mark of marks) {
        if (!known.has(mark)) {
          problems.push(
            `${target.src_path}: marked "${mark}", which is not one of ${[...known].join(", ")}`,
          );
        }
      }
      if (marks.length > 0) continue;

      const source = fs.readFileSync(target.src_path, "utf8");
      for (const need of needs) {
        for (const reach of need.reaches) {
          if (reach.test(source)) {
            problems.push(
              `${target.src_path}: reaches for ${need.what} (${reach.source}) and is not marked. Declare required-features = ["${need.feature}"] for this target, or take the reach out.`,
            );
            break;
          }
        }
      }
    }
  }

  // The second half. Every crate says where its own source is, so the walk is
  // over what cargo resolved rather than over a directory shape assumed here.
  for (const pkg of meta.packages) {
    for (const file of rsFiles(path.join(path.dirname(pkg.manifest_path), "src"))) {
      takeCfgTestItems(file);
    }
  }

  for (const region of regions) {
    const where = path.relative(process.cwd(), region.file) || region.file;
    for (const need of needs) {
      for (const reach of need.reaches) {
        if (reach.test(region.text)) {
          problems.push(
            `${where}:${region.line}: a test inside src/ reaches for ${need.what} (${reach.source}). It is part of the library target and cannot carry required-features, so no marking makes this legal. Move it to a target under tests/ and mark it "${need.feature}", or take the reach out.`,
          );
          break;
        }
      }
    }
  }

  if (problems.length > 0) {
    for (const line of problems) process.stderr.write(`test-scan: ${line}\n`);
    process.stderr.write(
      "test-scan: an unmarked test reaching for one of these makes the default suite need something a fresh clone does not have, and the failure it produces looks like a flake.\n",
    );
    process.exit(1);
  }

  const second = regions.length === 0
    ? "no test lives inside a crate src/, so that half judged nothing"
    : `${regions.length} test module(s) inside a crate src/, none of them reaching for any of the four`;
  process.stdout.write(
    `test-scan: ${looked} test target(s), every reach marked for what it needs; ${second}.\n`,
  );
});
'
