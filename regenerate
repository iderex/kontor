#!/bin/sh
# Every generated file that is committed, remade from what generates it.
#
#     regenerate            remake them
#     regenerate --check    remake them, refuse a difference, and refuse one
#                           that does not name its generator near its top
#
# A generated file that is committed and cannot be remade on demand becomes a
# file people edit by hand while believing it is generated, and the edit
# survives because nothing ever writes over it. The register below is the whole
# set, one entry per file, and --check is what stops the register from quietly
# going out of date: a hand edit that reaches the index is overwritten here and
# the difference is what fails.
#
# What the tree holds today is two lock files and nothing else. Neither is a
# convenience. A lock file is the resolution a build is reproducible from, and a
# hand edit to one is a build nobody can reproduce.
#
#     server/Cargo.lock, from server/Cargo.toml and the crate manifests under
#     server/crates/, remade by cargo. It carries its generator in its own first
#     two lines, which cargo writes.
#
#     client/package-lock.json, from client/package.json and the package
#     manifests under client/packages/, remade by npm. It carries its generator
#     in a `generatedBy` key, written by hand once and preserved by npm from
#     then on.
#
# That second paragraph said the opposite until this commit: that the file could
# carry no such header, because JSON has no comment and npm rewrites the file
# from its own model, so an added key would not survive. The middle claim is
# true and the conclusion drawn from it was not. It was found by adding a key to
# a copy of the file and running the two verbs that touch it, which is the
# reading that should have produced the sentence in the first place:
#
#     npm install --package-lock-only --ignore-scripts    # npm 11.16.0
#     npm ci --ignore-scripts
#
# The key survived both, the second regeneration wrote no difference against the
# first, and `npm ci` installed from the file with the key in it. What is true is
# narrower than what was written: npm preserves a key it does not know, and it
# writes no key it was not given, so a lock file built from nothing again has no
# header until one is put back. That is what the header rule below refuses.
#
# Both verbs write the file from its manifests and leave a resolution that is
# already satisfied alone, so running this does not silently take a newer
# dependency than the one the tree agreed on. Updating a dependency is a
# different verb and a different change, and it belongs with the issue that
# argues for the update.
#
# POSIX sh, matching ./build, and for the same reason: this is the toolchains'
# own verbs run in order, and the thing that must not be added here is a
# generator of its own.
#
# prove-determinism is what shows --check bites.
set -eu

check=no
if [ "${1-}" = "--check" ]; then
    check=yes
    shift
fi

cd "$(CDPATH= cd "${1:-$(dirname "$0")}" && pwd)"

# The register, in one place, so the two refusals below cannot come to hold
# different sets. Each line is a path and the string that names its generator
# inside that file, separated by a tab. A generated file is committed here only
# because a build has to be reproducible from it, and a reader who opens one
# without knowing that edits it. The second column is what tells them, and the
# header rule below is what stops the telling from going missing.
#
# What that rule catches is narrower than what it reads. Cargo writes its own
# header on every regeneration, so a deleted one is put back here and the
# difference rule refuses the edit before this rule sees anything. npm writes no
# key it was not given, so client/package-lock.json is the file this rule is
# actually holding. prove-determinism has a leg on each of the two and they
# assert different messages, which is where that difference is written down.
register() {
    printf '%s\t%s\n' 'server/Cargo.lock' '@generated by Cargo'
    printf '%s\t%s\n' 'client/package-lock.json' '"generatedBy": "npm'
}

generated=$(register | cut -f1 | tr '\n' ' ')

# How far into a file the header may be. Cargo writes its own on the first line.
# The npm key sits below the three keys npm puts at the top of the object, and
# npm decides that order rather than this tree, so the window is wider than the
# position the key holds today.
header_window=20

command -v cargo >/dev/null 2>&1 || { echo "regenerate: cargo is not on the path. CONTRIBUTING.md says what to install." >&2; exit 1; }
command -v npm >/dev/null 2>&1 || { echo "regenerate: npm is not on the path. CONTRIBUTING.md says what to install." >&2; exit 1; }

echo "regenerate: server/Cargo.lock"
cargo metadata --format-version 1 --manifest-path server/Cargo.toml >/dev/null

echo "regenerate: client/package-lock.json"
npm install --package-lock-only --ignore-scripts --silent --prefix client >/dev/null

if [ "$check" = no ]; then
    echo "regenerate: done. 'git diff' says whether anything moved."
    exit 0
fi

headers=0
# The separator is written as an escape rather than as the byte itself, so a
# reader can see it and an editor that trims trailing whitespace cannot delete
# it without the line stopping working visibly.
tab=$(printf '\t')
while IFS="$tab" read -r path marker; do
    if [ ! -f "$path" ]; then
        echo "regenerate: $path is in the register and is not in the tree." >&2
        headers=1
        continue
    fi
    # -F because a marker is a literal rather than a pattern: the npm one holds
    # a quote and the cargo one holds an at sign, and neither is meant to be
    # read as syntax.
    if head -n "$header_window" "$path" | grep -qF "$marker"; then
        echo "regenerate: $path names its generator."
    else
        echo "regenerate: $path does not name its generator in its first $header_window lines. It should hold: $marker" >&2
        headers=1
    fi
done <<EOF
$(register)
EOF

if [ "$headers" -ne 0 ]; then
    echo "regenerate: a generated file above carries no header naming what writes it, so a reader who opens it has nothing telling them not to edit it. Put the header back and run this again." >&2
    exit 1
fi

# shellcheck disable=SC2086
if git diff --exit-code --stat -- $generated; then
    echo "regenerate: every generated file is what its generator writes."
    exit 0
fi

echo "regenerate: the files above are not what their generator writes. Something edited a generated file by hand, or a manifest changed without this being run. Run 'regenerate' and commit the result." >&2
exit 1
