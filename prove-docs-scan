#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# The four documentation rules, shown to bite.
#
#     prove-docs-scan
#
# Each leg builds a throwaway repository holding the documents the case is
# about, runs the shipped scanner against it and reads the exit code. No leg
# restates a rule, so a rule loosened where it lives reddens the leg that
# depended on it rather than passing quietly.
#
# Every red leg is followed by its one-change neighbour, which has to pass.
# Without that pair a leg is also satisfied by a scanner that refuses whatever
# it is given, and the near miss here is small on purpose: the same sentence
# with the path corrected, or the same record with the number corrected, which
# is the edit somebody will actually make.
#
# The fixtures are repositories rather than loose files because every rule is
# about what is TRACKED. A document that exists in a working tree and was never
# committed is exactly the reference a reader cannot follow, so a fixture that
# only wrote the file would prove the weaker thing, and one leg below is that
# distinction on its own.
#
# The record legs write their own exemplar, and one of them renames a field in
# it and requires the rename to propagate. That leg is what says the scanner
# holds no copy of the header block: a scanner carrying its own list would stay
# green while the exemplar moved underneath it. The terminology legs are built
# the same way and one of them changes the word an entry answers with, for the
# same reason.
#
# THE VOCABULARY IN THE TERMINOLOGY LEGS IS A FIXTURE VOCABULARY. Not one of the
# words below is a word this project uses or refuses, and that is deliberate: a
# leg written against the real register would prove what the register held on
# the day it ran rather than that the rule reads a register at all.
#
# This tree is not what any leg judges. A run against the real documents proves
# the state of those documents on the day it ran, and the rule is what this
# file is about.
#
# POSIX sh, matching the script it proves, and for the same reason: a leg is an
# exit code from another program and nothing here needs a language that can do
# more than run one and read the number it returned.
set -eu

cd "$(CDPATH= cd "$(dirname "$0")" && pwd)"

root=$(pwd)
failed=0
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
count=0

pass() { echo "  ok    $1"; }
fail() { echo "  FAIL  $1" >&2; failed=1; }

# A repository the case writes its documents into. Line ending rewriting is
# turned off because this machine may be set to it, and the warning git prints
# on every fixture would bury the legs.
fixture() {
    count=$((count + 1))
    tmp="$work/$count"
    stage=-A
    git -c init.defaultBranch=main init -q "$tmp"
    git -C "$tmp" config core.autocrlf false
    mkdir -p "$tmp/docs/decisions"
}

# Content arrives on standard input, so a fixture document is written the way it
# will be read rather than through a layer of quoting.
put() {
    mkdir -p "$tmp/$(dirname "$1")"
    cat > "$tmp/$1"
}

# The record every other record is judged against. A leg that wants a different
# header block writes its own instead of calling this.
exemplar() {
    put docs/decisions/0001-means.md <<'RECORD'
# 0001. The means

Status: accepted
Issue: #1
Supersedes: nothing
Superseded by: nothing

## The decision

The exemplar this fixture judges the other records against.
RECORD
}

# The register the terminology rule reads. A leg that wants a different one
# writes its own instead of calling this.
words() {
    put documentation-words <<'WORDS'
# The fixture's own reason for its own word.
widgit -> widget
WORDS
}

judge() {
    what=$1
    expectation=$2
    rule=$3
    needle=$4

    # Every leg but one tracks what it wrote. The exception sets stage to the
    # subset it wants tracked, because the rule is about what is committed and a
    # fixture that tracked everything could not put that distinction under it.
    git -C "$tmp" add $stage

    if out=$(sh "$root/docs-scan" "$rule" "$tmp" 2>&1); then
        if [ "$expectation" = green ]; then
            pass "$what"
        else
            fail "$what (it passed, and it was supposed to be refused)"
        fi
    else
        if [ "$expectation" = red ]; then
            case $out in
                *"$needle"*) pass "$what" ;;
                *) fail "$what (it was refused, and not for this leg's reason: nothing it printed held '$needle')" ;;
            esac
        else
            fail "$what (it was refused, and it was supposed to pass)"
        fi
    fi
}

