#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# A refusal over credential shapes in tracked text.
#
#     secret-scan
#     secret-scan /path/to/a/checkout
#
# The ways a credential escapes are well known and most of them are about what a
# running program prints. This one is about what a repository holds: a key, a
# connection string or a token written into a file and committed is in every
# clone, in every fork, and in the history after somebody takes it out again.
# Rotating it is the only repair, which is why the cheap moment to catch one is
# before it is pushed.
#
# WHAT IT READS is a shape rather than a secret. Four of them, each named, each
# with a message saying what to do instead: a private key block, credentials
# inside a URL, a quoted literal assigned to a name that means a credential, and
# the token formats three widely used services issue in a shape nothing else
# has. What is printed rather than written here is which shapes those are and
# how many the tree carries, because a list in a document drifts against the
# check that decides it:
#
#     secret-scan
#
# THIS CHECK PRINTS NO VALUE IT FOUND, ever, in any of its messages. A refusal
# names the file, the line and the shape, and stops there. A check that quoted
# the value would put the credential into the log of every run that refused
# it, which is the failure it exists against arriving through the door marked
# evidence. The same rule holds for the register: a dangling entry is named by
# its line rather than by what it says.
#
# secrets-allowed is where a shape that is not a secret is declared, one line
# per value, with the reason on the line immediately above it. The register
# fails closed in both directions. An entry with no reason is refused, so a
# value cannot be exempted without somebody writing down why. An entry that no
# tracked file carries is refused too, so the list holds what the tree actually
# has rather than accumulating permissions nobody can retire: taking the last
# use of a value out reddens the entry that declared it, and the repair is to
# take the entry out in the same change.
#
# The register itself is not scanned. It holds the values it declares, so a
# scan that read it would find every entry inside the entry that permits it, and
# the dangling half would be satisfied by the register alone. Excluding it is
# what makes an entry answer to something outside itself.
#
# WHAT THIS DELIBERATELY DOES NOT REACH, since a green run says nothing about
# any of it.
#
# A secret that looks like nothing. A password that is a word, a key in a format
# no rule here knows, a value split across two lines: each of those passes. The
# shapes are a floor holding what a credential usually looks like, not a
# statement that the tree carries none.
#
# Whether a declared value is live. That a value is written down here as an
# example is somebody's judgement, and no reading of the tree checks it. The
# reason beside each entry is what a reviewer reads.
#
# An untracked file. This judges what git tracks, which is what a clone gets and
# what a push carries. A value sitting in a working tree and never committed is
# not in the repository and is not what this is about.
#
# A value that was committed and has since been taken out. This reads the tree
# rather than the history, so it refuses the commit that adds one and says
# nothing about a commit that already landed. History is what the platform's own
# scanning reads, and neither of those can be proved by a fixture in this tree,
# which is why this check is here as well rather than instead.
#
# prove-secret-scan is the evidence that this refuses what it names, against
# repositories it builds rather than against this tree.
#
# POSIX sh with the reading in awk, matching text-scan, workflow-scan and
# docs-scan, and for the same reason: every rule here is a question about lines
# of text plus one call to git, and a check that decides whether a credential is
# in the tree should not wait on a compiler or on a dependency somebody has to
# install first.
set -eu

cd "$(CDPATH= cd "${1:-$(dirname "$0")}" && pwd)"

# The register saying which credential shapes in this tree are not secrets.
# Named once, and the run fails closed where it is absent rather than letting a
# tree with no register be read as a tree with nothing to declare.
register=secrets-allowed

if [ ! -f "$register" ]; then
    echo "secret-scan: this tree holds no $register. Failing closed rather than reading a missing register as a tree with nothing to declare." >&2
    exit 1
fi

shapes=$(mktemp)
hits=$(mktemp)
trap 'rm -f "$shapes" "$hits"' EXIT

# name, pattern, and what to do instead, separated by tabs. The advice is here
# beside the pattern rather than in the message printer, so a shape cannot be
# added without somebody writing the sentence the person who trips it reads.
printf '%s\n' \
    'a private key block	-----BEGIN (?:[A-Z0-9 ]+ )?PRIVATE KEY-----	A private key in the tree is a private key in every clone of it. Read it from a file or the environment where the program runs, and rotate this one, because it is already out.' \
    'credentials inside a URL	[a-zA-Z][a-zA-Z0-9+.-]*://[^\s/:@]+:[^\s/@]+@[^\s/]+	Carry the address in the value and the credentials in the environment. A value that is safe to print is a value somebody may print, and this one is not.' \
    'a secret in an assignment	(?i)(?:password|passwd|secret|token|api[_-]?key)\s*[:=]\s*["\x27][A-Za-z0-9/+=_.-]{12,}["\x27]	Read it where the program runs. A value written into the tree stays in the history after it is taken out of the file.' \
    'a token a service issued	AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{36}|xox[abprs]-[A-Za-z0-9-]{10,}	Revoke it at the service that issued it before anything else, then read the replacement where the program runs.' \
    > "$shapes"

: > "$hits"

# git grep: 0 = found, 1 = nothing found, 2 or above = the search itself failed.
# The exit code is captured so `set -e` does not abort on the clean exit 1, and
# anything above 1 fails closed rather than being read as a tree with no hit.
#
# -I so a binary file is passed over rather than matched inside, and the
# register is excluded for the reason the header gives.
while IFS='	' read -r name pattern advice <&3; do
    rc=0
    found=$(git grep -I -n -o -P -e "$pattern" -- . ":!$register") || rc=$?

    case "$rc" in
        0)
            printf '%s\n' "$found" | awk -v shape="$name" -v advice="$advice" '
            {
                if (match($0, /^[^:]*:[0-9]+:/) == 0) {
                    next
                }
                head = substr($0, 1, RLENGTH - 1)
                value = substr($0, RLENGTH + 1)
                split(head, where, ":")
                printf "%s\t%s\t%s\t%s\t%s\n", shape, where[1], where[2], value, advice
            }
            ' >> "$hits"
            ;;
        1) ;;
        *)
            echo "secret-scan: git grep exited $rc. Failing closed rather than reading a broken search as a tree with nothing in it." >&2
            exit 1
            ;;
    esac
done 3< "$shapes"

awk -F'\t' -v register="$register" '
# The register first. An entry is a line that is not blank and not a comment,
# and its reason is the comment on the line immediately above it. Immediately is
# the whole of the rule: a reason separated from its entry by anything is a
# reason a later edit can leave behind.
NR == FNR {
    line = $0
    sub(/[ \t\r]+$/, "", line)

    if (line == "") {
        reason = ""
        next
    }

    if (substr(line, 1, 1) == "#") {
        body = substr(line, 2)
        sub(/^[ \t]+/, "", body)
        reason = body
        next
    }

    if (reason == "") {
        printf "secret-scan: %s:%d declares a value and carries no reason on the line above it. Write what it is and why it is not a secret, or take the entry out.\n", register, FNR > "/dev/stderr"
        broken++
        next
    }

    if (line in at) {
        printf "secret-scan: %s:%d declares a value the register already declares at line %d. One entry per value, so there is one reason to read.\n", register, FNR, at[line] > "/dev/stderr"
        broken++
        next
    }

    allowed[line] = 1
    at[line] = FNR
    entry_at[FNR] = line
    lines = FNR
    entries++
    reason = ""
    next
}

# Then the hits. A refusal names where the value is and what shape it has, and
# never what it says.
{
    judged++
    if ($4 in allowed) {
        used[$4] = 1
        declared++
        next
    }
    printf "secret-scan: %s:%s carries %s. %s\n", $2, $3, $1, $5 > "/dev/stderr"
    refused++
}

END {
    # By line rather than by walking the array, because awk fixes no order over
    # one and a check somebody reads twice should print the same thing twice.
    for (i = 1; i <= lines; i++) {
        if (i in entry_at && !(entry_at[i] in used)) {
            printf "secret-scan: %s:%d declares a value no tracked file carries. The register holds what the tree has, so take the entry out in the change that took the last use out.\n", register, i > "/dev/stderr"
            dangling++
        }
    }

    if (broken > 0 || refused > 0 || dangling > 0) {
        printf "secret-scan: %d value(s) in tracked text that nothing declares, %d declaration(s) the register cannot keep, %d declaration(s) no tracked file answers. No value found is printed above, only where one is.\n", refused + 0, broken + 0, dangling + 0 > "/dev/stderr"
        exit 1
    }

    if (judged == 0) {
        printf "secret-scan: no tracked file carries a shape this check knows, so it judged nothing. The shapes are a floor rather than a guarantee: a secret that looks like nothing passes.\n"
        exit 0
    }

    printf "secret-scan: %d credential shape(s) in tracked text, all of them among the %d value(s) secrets-allowed declares with a reason. Whether a declared value is live is not judged here, and no value found is printed by this check.\n", judged, entries
}
' "$register" "$hits"
